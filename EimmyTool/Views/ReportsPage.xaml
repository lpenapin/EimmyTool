<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EimmyTool.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowDefinitions="Auto,*">

        <TextBlock
            Text="Reportes"
            FontSize="28"
            FontWeight="SemiBold"/>

        <TabView Grid.Row="1" Margin="0,16,0,0">

            <!-- DAILY SALES -->
            <TabViewItem Header="Ventas">
                <StackPanel Spacing="12">

                    <DatePicker
                        x:Name="SalesDatePicker"
                        Header="Select date"
                        DateChanged="SalesDateChanged"/>

                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <TextBlock x:Name="InvoicesCountText"/>
                        <TextBlock x:Name="SalesTotalText"/>
                    </StackPanel>

                    <StackPanel>
                        <!-- HEADER -->
                        <Grid ColumnDefinitions="80,*,*,100"
                          Padding="8"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <TextBlock Text="Recibo #" Grid.Column="0"/>
                            <TextBlock Text="Cliente" Grid.Column="1"/>
                            <TextBlock Text="Usuario" Grid.Column="2"/>
                            <TextBlock Text="Total" Grid.Column="3"/>

                        </Grid>
                        <ListView x:Name="SalesList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                    <Grid ColumnDefinitions="80,*,*,100">
                                    <TextBlock Text="{Binding Id}"/>
                                    <TextBlock Text="{Binding Client}"  Grid.Column="1"/>
                                    <TextBlock Text="{Binding User}"  Grid.Column="2"/>
                                    <TextBlock Text="{Binding Total}" Grid.Column="3"/>
                                    </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>
                </StackPanel>
            </TabViewItem>

            <!-- STOCK -->
            <TabViewItem Header="Inventario">
                <StackPanel>

                    <!-- HEADER -->
                    <Grid ColumnDefinitions="*,100,*,120,120"
                          Padding="8"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <TextBlock Text="Producto" Grid.Column="0"/>
                        <TextBlock Text="Cantidad" Grid.Column="1"/>
                        <TextBlock Text="Descripción" Grid.Column="2"/>
                        <TextBlock Text="Costo" Grid.Column="3"/>
                        <TextBlock Text="Precio" Grid.Column="4"/>
                        
                    </Grid>

                    <ListView x:Name="StockList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,100,*,120,120" Padding="4">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Quantity}" Grid.Column="1" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Description}" Grid.Column="2"/>
                                    <TextBlock Text="{Binding Cost}" Grid.Column="3" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Price}" Grid.Column="4" TextAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </TabViewItem>

        </TabView>

    </Grid>
</Page>

