<Page
    x:Class="EimmyTool.Views.BuyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EimmyTool.Models"
    xmlns:converters="using:EimmyTool.Converters">
    <Page.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyConverter"/>
        <converters:DebtToBrushConverter x:Key="DebtColorConverter"/>
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,*">

        <!-- TITLE -->
        <TextBlock
            Text="Compras"
            FontSize="28"
            FontWeight="SemiBold"/>

        <!-- MAIN CONTENT -->
        <Border
                Grid.Row="1"
                Margin="0,20,0,0"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Auto">

            <Grid RowDefinitions="Auto,*" ColumnSpacing="20">

                <!-- TOP SECTION -->
                <Grid ColumnDefinitions="*,*">

                    <!-- LEFT: PROVIDER INFO -->
                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Información del Proveedor"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5" Spacing="12">
                            <TextBox 
                                x:Name="DniBox" 
                                Header="Cédula/NIT:" 
                                PlaceholderText="Ingrese cédula/NIT" 
                                Width="150" LostFocus="DniBox_LostFocus"/>
                            <TextBox
                                x:Name="DebtBox" 
                                Header="Deuda" 
                                Width="100"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5" Spacing="12">
                            <TextBox 
                                x:Name="NameBox" 
                                Header="Nombre"  
                                Width="200"/>
                            <TextBox 
                                x:Name="PhoneBox"
                                Header="Teléfono"
                                Width="100"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5" Spacing="12">
                            <TextBox 
                                x:Name="EmailBox" 
                                Header="Correo"
                                Width="150"/>
                            <TextBox 
                                x:Name="AddressBox" 
                                Header="Dirección"
                                Width="200"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- RIGHT: PRODUCT / STOCK -->
                    <StackPanel Grid.Column="1" Spacing="12">

                        <TextBlock
                                Text="Producto"
                                FontSize="20"
                                FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox
                                x:Name="SkuBox"
                                Header="SKU"
                                PlaceholderText="Escanear o ingresar SKU"
                                LostFocus="SkuBox_LostFocus"
                                Width="180"/>
                            <TextBox
                                x:Name="SupplierInvoice"
                                Header="# Factura del proveedor"
                                IsEnabled="True"
                                Width="180"/>

                        </StackPanel>
                        

                        <TextBox
                            x:Name="ProductNameBox"
                            Header="Producto"
                            IsReadOnly="True"/>
                        <TextBlock
                                x:Name="StockText"
                                FontStyle="Italic"
                                Foreground="Gray"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">

                            <TextBox
                                x:Name="QuantityBox"
                                Header="Cantidad"
                                Width="50"/>

                            <TextBox
                                x:Name="CostBox"
                                Header="Costo"
                                Width="100"
                                LostFocus="CostBox_LostFocus"/>

                            <TextBox
                                x:Name="PriceBox"
                                Header="Precio al detal"
                                Width="100"
                                LostFocus="PricetBox_LostFocus"/>
                            <TextBox
                                x:Name="RetailPriceBox"
                                Header="Precio al por mayor"
                                Width="150"
                                LostFocus="RetailPriceBox_LostFocus"/>

                            <Button
                                Content="Agregar item"
                                Width="100"
                                Click="AddItem_Click"/>

                        </StackPanel>
                        
                        </StackPanel>

                </Grid>

                <!-- ITEMS LIST -->
                <StackPanel Grid.Row="1" Margin="0,24,0,0">

                    <TextBlock
                            Text="Detalle de la compra"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"/>
                    <!-- HEADER -->
                    <Grid
                            ColumnDefinitions="*,2*,*,*,*"
                            Padding="8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        
                            <TextBlock Text=" " Grid.Column="0" FontWeight="SemiBold"/>
                            <TextBlock Text="Producto" Grid.Column="1" FontWeight="SemiBold"/>
                            <TextBlock Text="Cantidad" Grid.Column="2" FontWeight="SemiBold"/>
                            <TextBlock Text="Costo" Grid.Column="3" FontWeight="SemiBold"/>
                            <TextBlock Text="Total" Grid.Column="4" FontWeight="SemiBold"/>

                    </Grid>

                    <!-- LIST -->

                        <ListView x:Name="ItemsList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:BuyItem">
                                    <Grid ColumnDefinitions="*,2*,*,*,*" Padding="4">
                                        <!-- Remove -->
                                        <Button
                                            Grid.Column="0"
                                            Content="🗑"
                                            Click="RemoveItem_Click"
                                            Tag="{x:Bind}"/>
                                        <TextBlock Text="{x:Bind Name}" Grid.Column="1" />
                                        <TextBlock Text="{x:Bind Quantity}" Grid.Column="2"/>
                                        <TextBlock Text="{x:Bind UnitCost, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"
                                                   Grid.Column="3"/>
                                        <TextBlock Text="{x:Bind Total, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"
                                                   Grid.Column="4"/>
                                        
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>


                        <!-- TOTALS -->
                        <Border 
    BorderBrush="Gray" 
    BorderThickness="1" 
    CornerRadius="4" 
    Padding="12" 
    Margin="0,16,20,0" 
    HorizontalAlignment="Right">
                            <Grid
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Subtotal:" Grid.Row="0" Grid.Column="0"/>
                        <TextBlock x:Name="SubtotalText" Grid.Column="1" TextAlignment="Right"/>

                                <TextBlock Text="Descuento (%)" Grid.Row="1" Grid.Column="0"/>
                        <TextBox
                            x:Name="TaxBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="0"
                            TextAlignment="Right"
                            TextChanged="TaxBox_TextChanged"/>

                        <TextBlock Text="Tax Amount" Grid.Row="2" Grid.Column="0"/>
                        <TextBlock
                            x:Name="TaxAmountText"
                            Grid.Row="2"
                            Grid.Column="1"
                            TextAlignment="Right"/>

                        <TextBlock
                            Text="TOTAL"
                            FontWeight="SemiBold"
                            Grid.Row="3"/>

                        <TextBlock
                            x:Name="TotalText"
                            Grid.Row="3"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            TextAlignment="Right"/>

                    </Grid>
                        </Border>
                    </StackPanel>

            </Grid>
            </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right">
            <CheckBox 
                x:Name="CreditBuyCheckBox" 
                Content="A Credito"
                Checked="CreditBuy_TwoState_Checked"
                Unchecked="CreditBuy_TwoState_Unchecked"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"/>
            <TextBox
                x:Name="CreditBox"
                Header="Abono"
                Width="160"
                IsEnabled="False"
                LostFocus="CreditBox_LostFocus"/>
            <Button
                x:Name="SaveBuyButton"
                Content="Confirmar Compra"
                IsEnabled="False"
                HorizontalAlignment="Right"
                Margin="0,16,5,0"
                Click="SavePurcharse_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
