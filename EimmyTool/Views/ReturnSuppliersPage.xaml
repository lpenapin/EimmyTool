<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EimmyTool.Views.ReturnSuppliersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EimmyTool.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:models="using:EimmyTool.Models"
    xmlns:converters="using:EimmyTool.Converters">
    <Page.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyConverter"/>
        <converters:DebtToBrushConverter x:Key="DebtColorConverter"/>
    </Page.Resources>

    <Grid Padding="24" RowDefinitions="Auto,*">

        <!-- TITLE -->
        <StackPanel Orientation="Horizontal" Margin="0,5" Spacing="20">
            <TextBlock
    Text="Devolución a Proveedores"
    FontSize="28"
    FontWeight="SemiBold"/>

            <TextBox
        x:Name="InvoiceBox"
        PlaceholderText="Ingrese # de factura"
        LostFocus="InvoiceBox_LostFocus"/>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <Border
        Grid.Row="1"
        Margin="0,20,0,0"
        Padding="16"
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
          HorizontalScrollBarVisibility="Auto">

                <Grid RowDefinitions="Auto,*,*" ColumnSpacing="20">


                    <!-- TOP SECTION -->
                    <Grid ColumnDefinitions="*">

                        <!-- LEFT: SUPPLIER INFO -->
                        <StackPanel Spacing="10">

                            <TextBlock
                    Text="Información del proveedor"
                    FontSize="20"
                    FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5" Spacing="12">
                                <TextBox 
                                x:Name="DniBox" 
                                Header="Cédula/NIT" 
                                Width="150" 
                                IsReadOnly="True"/>
                                <TextBox
                                x:Name="DebtBox" 
                                Header="Deuda" 
                                Width="150"
                                IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5" Spacing="12">
                                <TextBox
                                x:Name="NameBox" 
                                Header="Nombre" 
                                Width="200"/>
                                <TextBox 
                                x:Name="PhoneBox" 
                                Header="Teléfono" 
                                Width="150"/>
                                <TextBox 
                                x:Name="EmailBox" 
                                Header="Correo" 
                                Width="200"/>
                                <TextBox 
                                x:Name="AddressBox" 
                                Header="Dirección" 
                                Width="200"/>
                            </StackPanel>

                        </StackPanel>



                    </Grid>

                    <!-- ITEMS LIST -->
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <TextBlock
                    Text="Detalle de la compra"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>
                        <!-- HEADER -->
                        <Grid
                    ColumnDefinitions="*,2*,*,*"
                    Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">

                            <TextBlock Text=" " Grid.Column="0" FontWeight="SemiBold"/>
                            <TextBlock Text="Producto" Grid.Column="1" FontWeight="SemiBold"/>
                            <TextBlock Text="Cantidad" Grid.Column="2" FontWeight="SemiBold"/>
                            <TextBlock Text="Precio" Grid.Column="3" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- LIST -->

                        <ListView x:Name="ItemsList">
                            <ListView.ItemTemplate>
                                <DataTemplate  x:DataType="models:InvoiceItem">
                                    <Grid ColumnDefinitions="*,2*,*,*" Padding="4">
                                        <!-- Remove -->
                                        <Button
                                        Grid.Column="0"
                                        Content="Agregar"
                                        Click="ReturnItem_Click"
                                        Tag="{x:Bind}"/>
                                        <TextBlock Text="{x:Bind ProductName}" Grid.Column="1" />
                                        <TextBlock Text="{x:Bind Quantity}" Grid.Column="2"/>
                                        <TextBlock Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"
                                               Grid.Column="3"/>
                                    </Grid>

                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!--RETURN ITEMS LIST -->
                    <StackPanel Grid.Row="2" Margin="0,24,0,0">
                        <TextBlock
                        Text="Detalle de la Devolución"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>
                        <!-- HEADER -->
                        <Grid
                        ColumnDefinitions="*,2*,*,*"
                        Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">

                            <TextBlock Text=" " Grid.Column="0" FontWeight="SemiBold"/>
                            <TextBlock Text="Producto" Grid.Column="1" FontWeight="SemiBold"/>
                            <TextBlock Text="Cantidad" Grid.Column="2" FontWeight="SemiBold"/>
                            <TextBlock Text="Precio" Grid.Column="3" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- LIST -->

                        <ListView x:Name="ReturnItemsList">
                            <ListView.ItemTemplate>
                                <DataTemplate  x:DataType="models:InvoiceItem">
                                    <Grid ColumnDefinitions="*,2*,*,*" Padding="4">
                                        <!-- Remove -->
                                        <Button
                                            Grid.Column="0"
                                            Content="🗑"
                                            Click="RemoveItem_Click"
                                            Tag="{x:Bind}"/>
                                        <TextBlock Text="{x:Bind ProductName}" Grid.Column="1" />
                                        <NumberBox 
                                            Value="{x:Bind Quantity, Mode=TwoWay}"
                                            Minimum="1"
                                            Maximum="{x:Bind MaxQuantity}"
                                            Grid.Column="2" 
                                            SpinButtonPlacementMode="Inline"
                                            SmallChange="1"
                                            MaxWidth="150"
                                            HorizontalAlignment="Left"/>
                                        <TextBlock Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"
                                               Grid.Column="3"/>
                                    </Grid>

                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- TOTALS -->
                        <Border 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="12" 
                        Margin="0,16,20,0" 
                        HorizontalAlignment="Right">
                            <Grid
                            Margin="0,16,0,0"
                            HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Subtotal:" Grid.Row="0" Grid.Column="0"/>
                                <TextBlock x:Name="SubtotalText" Grid.Column="1" TextAlignment="Right"/>

                                <!--<TextBlock Text="Tax (%)" Grid.Row="1" Grid.Column="0"/>
                            <TextBox
                                x:Name="TaxBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="0"
                                TextAlignment="Right"
                                TextChanged="TaxBox_TextChanged"/>

                            <TextBlock Text="Tax Amount" Grid.Row="2" Grid.Column="0"/>
                            <TextBlock
                                x:Name="TaxAmountText"
                                Grid.Row="2"
                                Grid.Column="1"
                                TextAlignment="Right"/> -->

                                <TextBlock
                                Text="TOTAL"
                                FontWeight="SemiBold"
                                Grid.Row="3"/>

                                <TextBlock
                                x:Name="TotalText"
                                Grid.Row="3"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                TextAlignment="Right"/>

                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right">

            <Button
        x:Name="SaveReturnButton"
        Content="Confirmar Devolución"
        IsEnabled="False"
        HorizontalAlignment="Right"
        Margin="0,16,5,0"
        Click="SaveReturn_Click"
        Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Page>
