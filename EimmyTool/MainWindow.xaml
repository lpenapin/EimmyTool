<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EimmyTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EimmyTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EimmyTool">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="NavView_SelectionChanged">

        <!-- App title -->
        <NavigationView.Header>
            <TextBlock
                Text="Eimmy Teen's"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="12,0"/>
        </NavigationView.Header>

        <!-- Menu items -->
        <NavigationView.MenuItems>

            <NavigationViewItem
                Content="Inicio"
                Icon="Home"
                Tag="Home"/>

            <NavigationViewItem
                Content="Ventas"
                Icon="Shop"
                Tag="Selling"/>

            <NavigationViewItem
                Content="Compras"
                Tag="Buying">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xe7bf;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Devoluciones"
                Tag="Returns">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xe8ab;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--<NavigationViewItem
                Content="Inventario"
                Icon="List"
                Tag="Inventory"/>-->

            <NavigationViewItem
                Content="Reportes"
                Icon="Calendar"
                Tag="Reports"/>

            <NavigationViewItem
                Content="Directorio"
                Icon="Contact2"
                Tag="Contacts"/>

        </NavigationView.MenuItems>

        <!-- Content -->
        <Frame x:Name="RootFrame"/>

    </NavigationView>
</Window>

