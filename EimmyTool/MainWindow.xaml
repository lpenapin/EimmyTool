<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EimmyTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EimmyTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EimmyTool">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="NavView_SelectionChanged">

        <!-- App title -->
        <NavigationView.Header>
            <TextBlock
                Text="Eimmy Teen's"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="12,0"/>
        </NavigationView.Header>

        <!-- Menu items -->
        <NavigationView.MenuItems>

            <NavigationViewItem
                Content="Inicio"
                Icon="Home"
                Tag="Home"/>

            <NavigationViewItem
                Content="Ventas"
                Icon="Shop"
                Tag="Selling"/>

            <NavigationViewItem
                Content="Compras"
                Tag="Buying">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xe7bf;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Devolución de Clientes"
                Tag="Returns">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xe8ab;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Devolución a Proveedores"
                Tag="SuppliersReturns">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xe8ab;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                Content="Inventario"
                Icon="List"
                Tag="Inventory"/>

            <NavigationViewItem
                Content="Reportes"
                Icon="Calendar"
                Tag="Reports"/>

            <NavigationViewItem
                Content="Directorio"
                Icon="Contact2"
                Tag="Contacts"/>

            <NavigationViewItem
                Content="Gastos Generales"
                Tag="GeneralExpenses">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xe781;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Cerrar Sesión" 
                            Icon="Back" 
                            Tag="Logout" 
                            Tapped="LogoutButton_Click" />
            <NavigationViewItem 
            Content="Acerca de" 
            Tag="About">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <!-- Content-->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Frame x:Name="RootFrame" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            
            <Grid x:Name="LoginOverlay" 
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" 
                  Canvas.ZIndex="100"
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch">
                
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Width="500">
                    <Image Source="/Assets/E-Tool.png" Width="150" Height="150" Margin="0,0,0,20"/>
                    <TextBlock Text="Bienvenido a EimmyTool" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>

                    <TextBox x:Name="UserIdInput" Header="ID de Usuario" PlaceholderText="Ingrese su ID"/>
                    <PasswordBox x:Name="PasswordInput" Header="Contraseña" PlaceholderText="Ingrese su contraseña"/>

                    <Button Content="Iniciar Sesión" 
                        Click="LoginButton_Click" 
                        Style="{StaticResource AccentButtonStyle}" 
                        HorizontalAlignment="Stretch" 
                        Margin="0,10,0,0"/>

                    <TextBlock x:Name="LoginErrorMessage" Foreground="Red" Visibility="Collapsed" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ResetPasswordOverlay" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Spacing="10">
                    <TextBlock Text="Cambio de Contraseña Requerido" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Debe cambiar su contraseña antes de continuar." TextWrapping="Wrap"/>

                    <PasswordBox x:Name="NewPasswordInput" PlaceholderText="Nueva contraseña"/>
                    <PasswordBox x:Name="ConfirmPasswordInput" PlaceholderText="Confirmar contraseña"/>

                    <TextBlock x:Name="ResetErrorMessage" Foreground="Red" Visibility="Collapsed"/>

                    <Button Content="Actualizar y Entrar" Click="UpdatePassword_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Grid>

    </NavigationView>
</Window>

